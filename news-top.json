{"updated_at": {"date": {"d": "17", "m": "10", "Y": "2026"}, "time": {"H": "06", "M": "23", "S": "49"}}, "news": [{"title": "Private equity investment in Indian real estate rises 16% to $4.5 billion in Jan-Sep 2026", "para": "Private equity inflows into Indian real estate increased 16% year-on-year to $4.5 billion during January-September 2026. Q3 inflows stood at $1.3 billion, with hospitality accounting for the largest share of quarterly investments at 26%.", "href": "https://realty.economictimes.indiatimes.com/news/industry/private-equity-investment-in-indian-real-estate-rises-16-to-4-5-billion-in-jan-sep-2026/135007157?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-298820/135007157.cms?width=150&height=112", "tag": "industry"}, {"title": "TGIIC gearing up for fresh land auction in Raidurg", "para": "Next week, the Telangana State Industrial Infrastructure Corporation plans an exciting land auction in Raidurg, presenting two parcels of land spanning six to seven acres each. A senior TGIIC official revealed that the reserve price will likely be around Rs 200 crore per acre, with the auction scheduled strategically before Diwali to entice potential buyers and boost overall auction values.", "href": "https://realty.economictimes.indiatimes.com/news/industry/tgiic-gearing-up-for-fresh-land-auction-in-raidurg/135007118?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-319632/135007118.cms?width=150&height=112", "tag": "industry"}, {"title": "Builders in West Bengal must have doctor, ambulance on construction sites with over 200 labourers", "para": "West Bengal's labour department has decreed that construction sites staffed by more than 200 workers must ensure the presence of a doctor at all times. Furthermore, an ambulance should be available to handle emergencies. Labour minister Arjun Singh recently convened with representatives from CREDAI to discuss these crucial measures. To uphold compliance, surprise inspections will be carried out, and any violations will face legal repercussions.", "href": "https://realty.economictimes.indiatimes.com/news/allied-industries/builders-in-west-bengal-must-have-doctor-ambulance-on-construction-sites-with-over-200-labourers/135007065?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-190884/135007065.cms?width=150&height=112", "tag": "allied-industries"}]}