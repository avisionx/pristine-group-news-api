{"updated_at": {"date": {"d": "23", "m": "10", "Y": "2026"}, "time": {"H": "19", "M": "36", "S": "32"}}, "news": [{"title": "NHB appoints forensic auditor for SRG Housing Finance", "para": "The National Housing Bank (NHB) has appointed ASA & Associates LLP to conduct a forensic audit of SRG Housing Finance amid allegations of fictitious loan accounts worth \u20b9300\u2013400 crore, repayment record manipulation and possible fund diversion. The investigation will examine loan disbursements, borrower identities, asset classifications and fund usage, with findings potentially shaping regulatory action and the lender\u2019s financial outlook.", "href": "https://realty.economictimes.indiatimes.com/news/housing-finance/nhb-appoints-forensic-auditor-for-srg-housing-finance/135147900?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-275326/135147900.cms?width=150&height=112", "tag": "housing-finance"}, {"title": "The LaLiT Suri Hospitality Group plans \u20b9600 crore expansion; to add about 1,000 keys", "para": "The LaLiT Suri Hospitality Group plans to invest \u20b9600 crore and add about 1,000 keys to its existing inventory of 2,300 keys, with roughly half of the new capacity coming through owned properties and the balance through management contracts.", "href": "https://realty.economictimes.indiatimes.com/news/hospitality/the-lalit-suri-hospitality-group-plans-600-crore-expansion-to-add-about-1000-keys/135147406?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-1939184/135147406.cms?width=150&height=112", "tag": "hospitality"}, {"title": "Shree Cement\u2019s net profit declines 15% to \u20b9263.46 crore in Q2 FY27", "para": "Shree Cement has seen a 15 percent drop in net profit for the second quarter of FY27, even as total income rose by 21.6 percent compared to last year. The company's domestic sales volume grew by 18 percent year-on-year, and its ready-mix concrete division significantly boosted sales volume and revenue. Despite facing obstacles, Shree Cement is aggressively pursuing new capacity expansions and initiatives for future growth.", "href": "https://realty.economictimes.indiatimes.com/news/cement/shree-cements-net-profit-declines-15-to-263-46-crore-in-q2-fy27/135147080?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-51572/135147080.cms?width=150&height=112", "tag": "cement"}]}