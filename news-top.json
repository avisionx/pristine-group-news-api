{"updated_at": {"date": {"d": "28", "m": "07", "Y": "2026"}, "time": {"H": "22", "M": "49", "S": "11"}}, "news": [{"title": "Bombay high court grants interim relief to SD Corporation in defamation suit", "para": "The Bombay High Court granted interim relief to SD Corporation regarding defamatory social media posts.  The court ordered that allegedly damaging content should not be circulated further.  SD Corporation alleged false and misleading posts targeted its MHADA redevelopment project.  The developer sought damages and an injunction against further publication of such material.  The court will hear the matter again on August 31, 2026.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/bombay-high-court-provides-temporary-relief-to-sd-corporation-in-defamation-case/132686619?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-365634/132686619.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Indian cities need $2.4 trillion investment by 2050: Report", "para": "Indian cities will need about $2.4 trillion of investment by 2050 to become climate-resilient and low-carbon, according to a FICCI-EY report. Only 20 municipal corporations have accessed capital markets so far, raising about $476 million.", "href": "https://realty.economictimes.indiatimes.com/news/infrastructure/24-trillion-investment-needed-for-indian-cities-by-2050-to-achieve-climate-resilience/132683394?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-2009764/132683394.cms?width=150&height=112", "tag": "infrastructure"}, {"title": "Shiva Cement gets approval for 2.4 MTPA dolomite mining in Odisha", "para": "Shiva Cement has received modified environmental clearance and consent to operate for its Khatkurbahal North limestone and dolomite mine in Odisha. The approval allows the company to commercially mine and sell 2.4 million tonnes of dolomite annually.", "href": "https://realty.economictimes.indiatimes.com/news/cement/shiva-cement-secures-environmental-clearance-for-24-mtpa-dolomite-mining-in-odisha/132683338?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-1801703/132683338.cms?width=150&height=112", "tag": "cement"}]}