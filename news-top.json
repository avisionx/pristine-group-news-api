{"updated_at": {"date": {"d": "24", "m": "09", "Y": "2026"}, "time": {"H": "07", "M": "20", "S": "13"}}, "news": [{"title": "ED widens Mohali real estate probe; serving, former IAS officers under scanner", "para": "The Enforcement Directorate escalates its probe into questionable financial dealings in Mohali's real estate market. Senior GMADA officials are under scrutiny, and searches are underway at the home of Rajiv Gupta, former GMADA Chief Administrator. The ED is dissecting transactions involving various real estate firms, particularly focusing on two auction sites tied to suspect developers. This investigation also intertwines with the ongoing inquiries surrounding the Suntec City project.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/ed-widens-mohali-real-estate-probe-serving-former-ias-officers-under-scanner/134451725?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-279666/134451725.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Shriram Properties to surpass doubling profit by FY29, explores mall-led rental income in West Bengal", "para": "With ambitious goals, Shriram Properties Ltd aims to double its net profit and sales bookings by FY29, fueled by a surge in project completions. Having reported a consolidated net profit of Rs 100.81 crore, the company is setting its sights on a realizable income of around Rs 3,000 crore. Its expansive construction pipeline spans about 50 million sq ft through FY29.", "href": "https://realty.economictimes.indiatimes.com/news/industry/shriram-properties-to-surpass-doubling-profit-by-fy29-explores-mall-led-rental-income-in-west-bengal/134451642?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-359016/134451642.cms?width=150&height=112", "tag": "industry"}, {"title": "High court appoints warrant officer after Punjab government seeks intervention in ED searches", "para": "The Punjab and Haryana High Court has intervened by appointing a warrant officer to closely watch the operations of the Enforcement Directorate. This directive comes on the heels of a plea from the Punjab government for immediate action amid ongoing inquiries. The Enforcement Directorate has executed searches related to suspected money laundering activities, focusing on the Greater Mohali Area Development Authority.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/high-court-appoints-warrant-officer-after-punjab-government-seeks-intervention-in-ed-searches/134451519?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-101516/134451519.cms?width=150&height=112", "tag": "regulatory"}]}