{"updated_at": {"date": {"d": "13", "m": "09", "Y": "2026"}, "time": {"H": "12", "M": "54", "S": "03"}}, "news": [{"title": "April\u2013Aug property registrations in Maharashtra jump 12% over last year, revenue up nearly 16%", "para": "In the first five months of the 2026-27 fiscal year, Maharashtra's property registrations saw a significant increase of 12.4%. The region's revenue collections experienced an impressive rise of nearly 16%, reaching Rs 26,637.73 crore. Steady transaction activity, particularly high-value deals, has fueled this growth. As the festive season approaches, officials anticipate that this positive momentum will further invigorate the property market.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/aprilaug-property-registrations-in-maharashtra-jump-12-over-last-year-revenue-up-nearly-16/134201374?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-151676/134201374.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Booking Holdings leases 1.11 lakh sq ft office space in Bengaluru", "para": "Booking Holdings has leased over 111,525 square feet of office space in Bengaluru. This expansion increases their total office footprint in the commercial tower to 2.65 lakh square feet. The company secured this new space through a five-year lease agreement with RMZ Hotels. This transaction highlights continued demand for large office spaces from global companies. Bengaluru remains a key market for multinational corporations expanding their operations.", "href": "https://realty.economictimes.indiatimes.com/news/commercial/booking-holdings-leases-1-11-lakh-sq-ft-office-space-in-bengaluru/134201180?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-281418/134201180.cms?width=150&height=112", "tag": "commercial"}, {"title": "Delhi LG approves health scheme for registered construction workers", "para": "The Lieutenant Governor of Delhi has sanctioned an innovative health scheme aimed at benefiting registered construction workers. This initiative provides annual health check-ups along with cashless outpatient services for the workers and their eligible spouses. Coverage for treatments can reach up to two lakh rupees for each beneficiary annually, and the Delhi Building and Other Construction Workers Welfare Board will oversee this significant program.", "href": "https://realty.economictimes.indiatimes.com/news/allied-industries/delhi-lg-approves-health-scheme-for-registered-construction-workers/134200776?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-230952/134200776.cms?width=150&height=112", "tag": "allied-industries"}]}