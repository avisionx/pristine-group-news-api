{"updated_at": {"date": {"d": "27", "m": "09", "Y": "2026"}, "time": {"H": "15", "M": "55", "S": "57"}}, "news": [{"title": "SC orders sealing of over 16,000 properties, demolition of illegal structures in Meerut", "para": "The Supreme Court has mandated the sealing and demolition of over 16,000 unauthorized buildings in Meerut. This ruling comes in response to troubling reports surrounding illegal housing developments in the region. A judicial commission has been established to delve into the circumstances and assess the lack of action from local authorities.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/sc-orders-sealing-of-over-16000-properties-demolition-of-illegal-structures-in-meerut/134522544?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-89680/134522544.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Delhi development body holds investors' meet to push its slum rehabilitation plan", "para": "On September 25, the Delhi Development Authority hosted an Investors' Meet aimed at propelling its In-Situ Slum Rehabilitation Programme. Engaging developers explored prospects and shared insights into enhancing rehabilitation projects in Delhi. The Master Plan for Delhi 2047 envisions assisting around 17 lakh JJ cluster inhabitants, significantly boosting housing conditions.", "href": "https://realty.economictimes.indiatimes.com/news/infrastructure/delhi-development-body-holds-investors-meet-to-push-its-slum-rehabilitation-plan/134522474?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-72284/134522474.cms?width=150&height=112", "tag": "infrastructure"}, {"title": "Innovist leases 2.62 lakh sq ft warehouse in Gurugram for five years", "para": "Onesto Labs, which operates Innovist brands including Bare Anatomy, Chemist at Play and SunScoop, has leased about 2.62 lakh sq ft at Horizon Industrial Park in Gurugram. The five-year transaction entails monthly rent of about \u20b972.14 lakh once both phases become rent-bearing and an estimated rental outgo of around \u20b947 crore over the tenure.", "href": "https://realty.economictimes.indiatimes.com/news/allied-industries/innovist-leases-2-62-lakh-sq-ft-warehouse-in-gurugram-for-five-years/134498362?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-196046/134498362.cms?width=150&height=112", "tag": "allied-industries"}]}