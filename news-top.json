{"updated_at": {"date": {"d": "24", "m": "09", "Y": "2026"}, "time": {"H": "01", "M": "59", "S": "59"}}, "news": [{"title": "Max Estates to jointly develop 9.76-acre project in Ghaziabad", "para": "Max Estates has entered into a binding MoU for a proposed joint development agreement covering a 9.76-acre land parcel in Indirapuram, Ghaziabad. The project has an estimated development potential of about 1.5 million sq ft and GDV of \u20b92,500-3,000 crore.", "href": "https://realty.economictimes.indiatimes.com/news/industry/max-estates-to-jointly-develop-9-76-acre-project-in-ghaziabad/134440223?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-156170/134440223.cms?width=150&height=112", "tag": "industry"}, {"title": "Shriram Properties to pump in \u20b94,000 crore more into Uttarpara project", "para": "Shriram Properties plans a massive investment of Rs 4,000 crore in its Uttarpara project, diversifying into residential, commercial, healthcare, and educational facilities. Having already invested Rs 2,000 crore, they've developed 65 acres, with ongoing projects including 3,400 flats in phase two and 198 villas in phase three. The company's CMD envisions a transformation that will turn Uttarpara into a thriving hub akin to Bengaluru's Whitefield.", "href": "https://realty.economictimes.indiatimes.com/news/industry/shriram-properties-to-pump-in-4000-crore-more-into-uttarpara-project/134439833?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-475572/134439833.cms?width=150&height=112", "tag": "industry"}, {"title": "Runwal Enterprises targets 2:1 debt-equity ratio after IPO: Chairman", "para": "Runwal Enterprises is gearing up for a significant Rs 500-crore initial public offering set to debut on September 25. The funds raised will facilitate debt repayment and support new project acquisitions. With a current debt-to-equity ratio of 3:1, the company aims to trim this down to 2:1. Furthermore, it plans to transition to an asset-light model and focus on expansion in the western suburbs over the next few years.", "href": "https://realty.economictimes.indiatimes.com/news/industry/runwal-enterprises-targets-21-debt-equity-ratio-after-ipo-chairman/134437953?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-65934/134437953.cms?width=150&height=112", "tag": "industry"}]}