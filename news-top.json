{"updated_at": {"date": {"d": "17", "m": "10", "Y": "2026"}, "time": {"H": "14", "M": "33", "S": "48"}}, "news": [{"title": "DHBVN directs ATS Triumph's developer to separate power, upkeep charges", "para": "Dakshin Haryana Bijli Vitran Nigam has ordered ATS Triumph to create a unified billing format for residents. This directive comes after the Haryana Electricity Regulatory Commission identified issues with billing methods and infrastructure. The developer is expected to delineate maintenance and diesel generator fees in bills to safeguard against disconnections. Compliance deadlines have been established to foster transparency and address customer concerns more efficiently.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/dhbvn-directs-ats-triumphs-developer-to-separate-power-upkeep-charges/135014051?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-96854/135014051.cms?width=150&height=112", "tag": "regulatory"}, {"title": "DLF enters collaboration for 7.48-acre Gurugram land; Sector 61 parcel to expand to 36 acres", "para": "DLF has entered into a collaboration for a fresh 7.48-acre parcel adjoining its existing land in Sector 61, Gurugram, taking the contiguous site to about 36 acres. The company aims to conclude the transaction by Q4 FY27 and is also preparing residential launches in Mumbai and DLF Phase 4.", "href": "https://realty.economictimes.indiatimes.com/news/industry/dlf-enters-collaboration-for-7-48-acre-gurugram-land-sector-61-parcel-to-expand-to-36-acres/135013939?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-103/135013939.cms?width=150&height=112", "tag": "industry"}, {"title": "Building around heritage, not over it: A new approach to urban development in India\u2019s historic cities", "para": "Historic cities stand at a crossroads where preservation meets modern progress, requiring thoughtful integration of contemporary architecture alongside traditional landscapes. Ensuring sustainability and honoring local customs can significantly improve urban life. Developers are encouraged to assess how new structures will affect neighboring communities and shared spaces, fostering an environment where a robust economy flourishes in harmony with cultural heritage.", "href": "https://realty.economictimes.indiatimes.com/blog/building-around-heritage-not-over-it-a-new-approach-to-urban-development-in-indias-historic-cities/135013104?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-188328/135013104.cms?width=150&height=112", "tag": "building-around-heritage-not-over-it-a-new-approach-to-urban-development-in-indias-historic-cities"}]}