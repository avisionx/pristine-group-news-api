{"updated_at": {"date": {"d": "26", "m": "08", "Y": "2026"}, "time": {"H": "06", "M": "26", "S": "20"}}, "news": [{"title": "About 3.5 lakh new PMAY homes approved for Assam: Chief minister", "para": "Assam Chief Minister Himanta Biswa Sarma engaged with Union Agriculture Minister Shivraj Singh Chouhan, securing approval for the construction of 3.1 lakh homes under the PM Awas Yojana. This initiative marks an investment of Rs 5,000 crore aimed at enhancing housing in Assam, particularly benefiting areas affected by flooding. Furthermore, the state has been granted Rs 139 crore dedicated to agricultural development projects.", "href": "https://realty.economictimes.indiatimes.com/news/residential/about-3-5-lakh-new-pmay-homes-approved-for-assam-chief-minister/133530915?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-124958/133530915.cms?width=150&height=112", "tag": "residential"}, {"title": "Cyberabad civic body orders crackdown on illegal buildings built on 75 sq yards, demolishes nine structures", "para": "Following a serious incident involving a building collapse, the Cyberabad Municipal Corporation is enhancing its crackdown on illegal constructions. A total of 38 structures have been flagged for enforcement actions. The focus is on those taller than permitted limits on compact plots, while also addressing projects on larger plots that lack the necessary permits. Continuous daily inspections are in place to ensure adherence to building regulations.", "href": "https://realty.economictimes.indiatimes.com/news/infrastructure/cyberabad-civic-body-orders-crackdown-on-illegal-buildings-built-on-75-sq-yards-demolishes-nine-structures/133529922?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-261350/133529922.cms?width=150&height=112", "tag": "infrastructure"}, {"title": "IHCL board approves merger of Oriental Hotels with share swap ratio of 25:117", "para": "The boards of Indian Hotels Company and Oriental Hotels have approved a scheme of arrangement for the amalgamation of Oriental Hotels with IHCL. The all-stock transaction proposes a share exchange ratio of 25 IHCL shares for every 117 Oriental Hotels shares.", "href": "https://realty.economictimes.indiatimes.com/news/hospitality/ihcl-board-approves-merger-of-oriental-hotels-with-share-swap-ratio-of-25117/133529766?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-321216/133529766.cms?width=150&height=112", "tag": "hospitality"}]}