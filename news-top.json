{"updated_at": {"date": {"d": "12", "m": "10", "Y": "2026"}, "time": {"H": "00", "M": "47", "S": "55"}}, "news": [{"title": "Rustomjee Group explores senior living foray; sees scope for over 5,000 homes in MMR", "para": "Rustomjee Group is evaluating an entry into senior living and is open to developing projects independently or with a partner, chairman and managing director Boman Irani said. While the investment and development structure are yet to be finalised, he estimates that Mumbai Metropolitan Region can support more than 5,000 senior living homes.", "href": "https://realty.economictimes.indiatimes.com/news/industry/rustomjee-group-explores-senior-living-foray-sees-scope-for-over-5000-homes-in-mmr/134871768?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-48968/134871768.cms?width=150&height=112", "tag": "industry"}, {"title": "Siddha Group targets \u20b91,894 crore turnover by FY30; plans listing by March 2028", "para": "Siddha Group expects its turnover to increase 42% to \u20b9852 crore in FY27 from \u20b9600 crore in FY26 and reach \u20b91,894 crore by FY30. The developer has estimated construction expenditure of \u20b91,063 crore for three upcoming Mumbai projects and plans to become a listed entity by March 2028 through an internal restructuring exercise.", "href": "https://realty.economictimes.indiatimes.com/news/industry/siddha-group-targets-1894-crore-turnover-by-fy30-plans-listing-by-march-2028/134870883?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-190462/134870883.cms?width=150&height=112", "tag": "industry"}, {"title": "Bombay HC quashes stamp duty demands on Goregaon property transactions", "para": "The Bombay High Court has quashed stamp duty demands on property transactions in Goregaon that involved multiple agreements. Authorities initially treated the 2012 conveyances as new transactions instead of finalizing earlier agreements from 1985. The Court emphasized the importance of analyzing the entire chain of documents to understand the transactions. It ruled that the final conveyances only completed previous arrangements rather than initiating new sales.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/bombay-hc-quashes-stamp-duty-demands-on-goregaon-property-transactions/134865670?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-1291820/134865670.cms?width=150&height=112", "tag": "regulatory"}]}