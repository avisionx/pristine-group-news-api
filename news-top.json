{"updated_at": {"date": {"d": "05", "m": "08", "Y": "2026"}, "time": {"H": "13", "M": "38", "S": "19"}}, "news": [{"title": "Smartworks leases 1.41 lakh sq ft in NCR; IWG opens four new Regus centres", "para": "Smartworks leased 1.41 lakh sq ft in Aerocity, Delhi, reporting strong revenue growth. The company has a significant secured footprint across India and Singapore. IWG opened four new Regus centers in Noida, Bengaluru, and Hyderabad. These additions expand IWG's flexible workspace network in India. IWG plans over 325 centers in India within three to five years.", "href": "https://realty.economictimes.indiatimes.com/news/commercial/iwg-opens-four-new-regus-centres-in-noida-bengaluru-hyderabad/132887590?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-1874363/132887590.cms?width=150&height=112", "tag": "commercial"}, {"title": "Bhubaneswar civic body notice to 4,632 city homes over illegal commercial use", "para": "In a decisive move, Bhubaneswar Municipal Corporation has reached out to 4,632 homeowners potentially breaking regulations by running commercial enterprises from their residences. Each homeowner has a month to provide evidence of their property's usage. Failing to comply could lead to the sealing of properties marked unauthorized. The civic body has also submitted a report on these actions to the Supreme Court.", "href": "https://realty.economictimes.indiatimes.com/news/commercial/bhubaneswar-civic-body-notice-to-4632-city-homes-over-illegal-commercial-use/132892799?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-320736/132892799.cms?width=150&height=112", "tag": "commercial"}, {"title": "Indore administration demolishes colony being developed illegally", "para": "In a decisive action, district authorities demolished an unauthorized residential settlement in Pipliya Rao village, reclaiming nearly two acres of valuable government land worth Rs 30 crore. This site had been illegally occupied by Nirbhay and Lalu Nagar, who were not only selling plots but also operating a flour processing facility. The administration effectively dismantled the entire layout and removed the industrial setup to restore the integrity of public land.", "href": "https://realty.economictimes.indiatimes.com/news/infrastructure/indore-administration-demolishes-colony-being-developed-illegally/132892490?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-293846/132892490.cms?width=150&height=112", "tag": "infrastructure"}]}