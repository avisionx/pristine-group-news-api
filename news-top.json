{"updated_at": {"date": {"d": "23", "m": "09", "Y": "2026"}, "time": {"H": "08", "M": "53", "S": "44"}}, "news": [{"title": "Bhubaneswar development body opens online application process for Ekamra Residency flats", "para": "Ekamra Residency, a housing project by Bhubaneswar Development Authority, has launched its online application process. The pricing for 2BHK apartments ranges from Rs 78.36 lakh to Rs 79.94 lakh and higher for premium units. Comparatively, government housing schemes in Delhi and Mumbai offer lower-priced options for similar categories. The project\u2019s amenities include a rooftop pool and community center, targeting an upper-middle segment.", "href": "https://realty.economictimes.indiatimes.com/news/residential/bhubaneswar-development-body-opens-online-application-process-for-ekamra-residency-flats/134428662?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-319270/134428662.cms?width=150&height=112", "tag": "residential"}, {"title": "Jaipur development body introduces verification system to curb defaulting builders", "para": "The Jaipur Development Authority has launched a comprehensive verification process targeting builders with outstanding lease dues. This initiative connects new applications to the identities of directors and promoters, enhancing accountability within the sector. As a prerequisite for proposal consideration, this consolidated database will play a critical role in evaluating submissions.", "href": "https://realty.economictimes.indiatimes.com/news/industry/jaipur-development-body-introduces-verification-system-to-curb-defaulting-builders/134428526?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-148016/134428526.cms?width=150&height=112", "tag": "industry"}, {"title": "Supreme court dismisses plea against additional FAR for Great Value Realty\u2019s Ekanam", "para": "The Supreme Court has dismissed the Great Value Sharanam Apartment Owners Association\u2019s special leave petition against the Allahabad High Court\u2019s July 1 judgment in the additional FAR dispute concerning Ekanam in Sector 107, Noida.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/supreme-court-dismisses-plea-against-additional-far-for-great-value-realtys-ekanam/134425837?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-162356/134425837.cms?width=150&height=112", "tag": "regulatory"}]}