{"updated_at": {"date": {"d": "08", "m": "08", "Y": "2026"}, "time": {"H": "08", "M": "25", "S": "36"}}, "news": [{"title": "Vadodara civic body extends advance property tax rebate scheme till September 10", "para": "The Vadodara Municipal Corporation has announced an extension of its property tax rebate scheme until September 10. Homeowners can take advantage of an 11 percent rebate if they make their payments online. Additionally, commercial property owners can benefit from a 6 percent rebate. So far, the civic body has successfully collected over Rs 186 crore through this advance tax initiative.", "href": "https://realty.economictimes.indiatimes.com/news/residential/vadodara-civic-body-extends-advance-property-tax-rebate-scheme-till-september-10/133048046?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-89342/133048046.cms?width=150&height=112", "tag": "residential"}, {"title": "MMRDA ropes in Singapore\u2019s Surbana Jurong for Mumbai 3.0 master plan", "para": "Singapore's Surbana Jurong will prepare the Mumbai 3.0 new town master plan. This new town will span over 323 square kilometers across Raigad district. The planning process involves detailed analysis and stakeholder consultations for development. Maharashtra's Deputy Chief Minister highlighted global expertise for this project. Mumbai 3.0 aims to be a sustainable and investment-ready global growth center.", "href": "https://realty.economictimes.indiatimes.com/news/infrastructure/mmrda-ropes-in-singapores-surbana-jurong-for-mumbai-3-0-master-plan/133047992?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-29926/133047992.cms?width=150&height=112", "tag": "infrastructure"}, {"title": "Goa government allows citizens to register property document at any sub-registrar office in district", "para": "Goa has introduced property document registration at any Sub-Registrar Office within districts. This new facility aims to enhance access and reduce citizen waiting times significantly. Senior citizens and NRIs will benefit from increased flexibility and reduced travel needs. The initiative is expected to distribute workload evenly and improve service efficiency.", "href": "https://realty.economictimes.indiatimes.com/news/residential/goa-government-allows-citizens-to-register-property-document-at-any-sub-registrar-office-in-district/133045759?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-69546/133045759.cms?width=150&height=112", "tag": "residential"}]}