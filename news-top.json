{"updated_at": {"date": {"d": "08", "m": "08", "Y": "2026"}, "time": {"H": "06", "M": "31", "S": "31"}}, "news": [{"title": "Goa government allows citizens to register property document at any sub-registrar office in district", "para": "Goa has introduced property document registration at any Sub-Registrar Office within districts. This new facility aims to enhance access and reduce citizen waiting times significantly. Senior citizens and NRIs will benefit from increased flexibility and reduced travel needs. The initiative is expected to distribute workload evenly and improve service efficiency.", "href": "https://realty.economictimes.indiatimes.com/news/residential/goa-government-allows-citizens-to-register-property-document-at-any-sub-registrar-office-in-district/133045759?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-69546/133045759.cms?width=150&height=112", "tag": "residential"}, {"title": "Dharwad consumer panel orders builder to refund 83 plot buyers with 10% interest", "para": "In a significant ruling, a consumer commission has mandated a Hubballi developer to refund 83 buyers who purchased plots in the failed Sai Ram City layout. Despite receiving deposits and installment payments over two years, the developer neglected the promised development. The commission identified service deficiencies and unfair practices, ordering the developer to return the full amount with 10% annual interest and additional compensation.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/dharwad-consumer-panel-orders-builder-to-refund-83-plot-buyers-with-10-interest/133045996?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-109691/133045996.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Andhra Pradesh government clears pilot slum redevelopment project in Visakhapatnam", "para": "The government of Andhra Pradesh has green-lighted the Velampeta slum redevelopment initiative in Visakhapatnam. This innovative project operates under a public-private partnership and a Design, Build, Finance, Transfer framework. Families from economically weaker sections will be relocated within the same area, while Transferable Development Rights will help to fill the funding void.", "href": "https://realty.economictimes.indiatimes.com/news/industry/andhra-pradesh-government-clears-pilot-slum-redevelopment-project-in-visakhapatnam/133045899?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-51754/133045899.cms?width=150&height=112", "tag": "industry"}]}