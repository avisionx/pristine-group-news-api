{"updated_at": {"date": {"d": "27", "m": "07", "Y": "2026"}, "time": {"H": "20", "M": "59", "S": "49"}}, "news": [{"title": "NGT directs verification of continuing 'illegal' construction in Greater Noida", "para": "The National Green Tribunal has directed the Uttar Pradesh Pollution Control Board to verify allegations. Some under-construction projects in Greater Noida allegedly continue despite closure orders for environmental violations. The tribunal is hearing a matter filed by BJP leader Rajendra Tyagi regarding these projects. The Greater Noida Industrial Development Authority is also examining details of these alleged violations.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/ngt-directs-verification-of-continuing-illegal-construction-in-greater-noida/132665891?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-1549826/132665891.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Mumbai: Pattathu Brothers' directors booked for failing to hand over amenities to housing society", "para": "According to a complaint lodged by an SRA assistant engineer, Joseph S Pattathu and Pearl Joseph Pattathu, directors of Pattathu Brothers, allegedly breached redevelopment terms by failing to transfer possession of six required facilities to the eligible beneficiaries after securing completion certificates for the project.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/mumbai-realty-firm-directors-charged-for-withholding-amenities-from-housing-society/132665807?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-651756/132665807.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Retailers lease 4.1 million sq ft Grade-A mall space in H1 2026: Report", "para": "India\u2019s top seven cities recorded gross leasing of 4.1 million sq ft of Grade-A mall space in H1 2026, against new completions of 0.9 million sq ft, according to Anarock. Grade-A mall vacancy declined to 6.7%, the lowest level since 2010.", "href": "https://realty.economictimes.indiatimes.com/news/retail/retail-leasing-surges-to-41-million-sq-ft-in-indias-top-cities-amid-supply-shortage/132654430?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-1766782/132654430.cms?width=150&height=112", "tag": "retail"}]}