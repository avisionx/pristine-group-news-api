{"updated_at": {"date": {"d": "16", "m": "11", "Y": "2026"}, "time": {"H": "12", "M": "10", "S": "17"}}, "news": [{"title": "Odisha distributes housing benefits to five lakh beneficiaries under PMAY-Gramin", "para": "During the programme, 248 projects worth Rs 911.14 crore were also inaugurated by CM Majhi and their foundation stones were laid across Balangir district. The projects cover several sectors, including healthcare, drinking water, irrigation, Anganwadi centres, additional classrooms, roads and hostels.", "href": "https://realty.economictimes.indiatimes.com/news/residential/odisha-distributes-housing-benefits-to-five-lakh-beneficiaries-under-pmay-gramin/135887805?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-116876/135887805.cms?width=150&height=112", "tag": "residential"}, {"title": "Ahmedabad civic body plans smart upgrade for two lakh streetlight poles", "para": "The Ahmedabad Municipal Corporation is set to revamp streetlights and deploy an optical fiber network throughout the city. This initiative aims to transform streetlight poles into versatile platforms for telecom services and smart city innovations. It also involves implementing advanced controllers and monitoring systems to improve maintenance efficiency. Ensuring a minimum of 99% lighting during night hours is mandatory, with financial penalties in place for non-compliance to emphasize accountability.", "href": "https://realty.economictimes.indiatimes.com/news/lighting/outdoor-lighting/ahmedabad-civic-body-plans-smart-upgrade-for-two-lakh-streetlight-poles/135873562?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-236394/135873562.cms?width=150&height=112", "tag": "lighting"}, {"title": "Pune civic body moves to attach 33 properties of Sinhgad Institutes over \u20b9295-crore property tax dues", "para": "The Pune Municipal Corporation aims to recover Rs 295 crore in outstanding property taxes from Sinhgad Institutes by proposing the attachment of 33 of its properties. Despite previous enforcement attempts falling short, this new strategy seeks to auction off the properties if approved. Importantly, the corporation assures that the academic activities of the institutes will proceed without disruption throughout this recovery effort.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/pune-civic-body-moves-to-attach-33-properties-of-sinhgad-institutes-over-295-crore-property-tax-dues/135873486?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-103/135873486.cms?width=150&height=112", "tag": "regulatory"}]}