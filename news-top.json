{"updated_at": {"date": {"d": "25", "m": "10", "Y": "2026"}, "time": {"H": "17", "M": "26", "S": "17"}}, "news": [{"title": "Bombay HC junks order for further EOW probe against developer in Mumbai redevelopment case", "para": "The Bombay High Court overturned a magistrate's directive for further inquiry into a developer. Previously, the economic offences wing had closed the investigation due to a lack of substantial evidence. The developer argued that the complainant, Vinod Jain, had a record of frivolous complaints, with two earlier probes finding no validity in Jain's claims.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/bombay-hc-junks-order-for-further-eow-probe-against-developer-in-mumbai-redevelopment-case/135187067?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-1094538/135187067.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Hyderabad development body banks on Neopolis auctions for \u20b92,000 crore haul", "para": "Next month, the Hyderabad Metropolitan Development Authority is set to auction off 114 land parcels, with a target of raising around Rs 2,000 crore. Prime areas under consideration include Kokapet, Raidurg, and Banjara Hills, which are expected to garner significant interest. The auction features parcels with established reserve prices, particularly spotlighting Kokapet's Neopolis layout.", "href": "https://realty.economictimes.indiatimes.com/news/industry/hyderabad-development-body-banks-on-neopolis-auctions-for-2000-crore-haul/135185953?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-329688/135185953.cms?width=150&height=112", "tag": "industry"}, {"title": "Housing board scraps \u2018betterment\u2019 fee on land near its colonies in Ghaziabad", "para": "The Uttar Pradesh Housing Board has removed the betterment fee and no-objection certificate mandates for projects located within 500 metres of housing colonies in Ghaziabad. This revision is expected to simplify the development process by eliminating costly delays. This initiative is in harmony with the UP Building Construction and Development Byelaws 2025, aiming to boost urbanization and construction efficiency in the region.", "href": "https://realty.economictimes.indiatimes.com/news/industry/housing-board-scraps-betterment-fee-on-land-near-its-colonies-in-ghaziabad/135185874?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-72996/135185874.cms?width=150&height=112", "tag": "industry"}]}