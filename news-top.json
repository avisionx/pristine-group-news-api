{"updated_at": {"date": {"d": "26", "m": "11", "Y": "2026"}, "time": {"H": "22", "M": "40", "S": "11"}}, "news": [{"title": "The Phoenix Mills elevates its Kurla office district through a comprehensive campus transformation", "para": "The Phoenix Mills Ltd. is on a mission to reinvent its renowned office district in Kurla over an 18-month span. The transformation will involve a thoughtful redesign of architecture and communal spaces, enhancing the atmosphere for businesses and their employees alike. With improved facades and safer pedestrian pathways, the project signifies a strong commitment to fostering commercial growth in the region.", "href": "https://realty.economictimes.indiatimes.com/news/brand-connect-initiative/the-phoenix-mills-elevates-its-kurla-office-district-through-a-comprehensive-campus-transformation/136194169?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-194978/136194169.cms?width=150&height=112", "tag": "brand-connect-initiative"}, {"title": "Mumbai: BMC\u2019s move to hand over Bandra Reclamation plots to SRA project\u2019s developer sparks controversy", "para": "A proposal by BMC to hand over public plots in Bandra Reclamation to a private developer has raised concerns. Citizens and public representatives are questioning the necessity of this move. Corporator Karen D\u2019Mello has urged the cancellation of the proposal, citing public access issues. Former corporator Asif Zakaria has challenged the legality of BMC's actions regarding open spaces.", "href": "https://realty.economictimes.indiatimes.com/news/infrastructure/mumbai-bmcs-move-to-hand-over-bandra-reclamation-plots-to-sra-projects-developer-sparks-controversy/136178445?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-307004/136178445.cms?width=150&height=112", "tag": "infrastructure"}, {"title": "Kolkata: 100 real estate projects stuck as approvals stall in growth belt of Salt Lake-Sector V-New Town", "para": "The approval process for real estate developments in Bidhannagar Municipal Corporation, New Town Kolkata Development Authority, and Nabadiganta Industrial Township Authority has hit a standstill. Nearly 100 projects, totaling 15 million square feet and involving an investment of around Rs 7,500 crore, are currently stalled, causing difficulties for developers as well as workers, contractors, and related businesses.", "href": "https://realty.economictimes.indiatimes.com/news/industry/kolkata-100-real-estate-projects-stuck-as-approvals-stall-in-growth-belt-of-salt-lake-sector-v-new-town/136178317?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-242168/136178317.cms?width=150&height=112", "tag": "industry"}]}