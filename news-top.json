{"updated_at": {"date": {"d": "28", "m": "09", "Y": "2026"}, "time": {"H": "10", "M": "15", "S": "22"}}, "news": [{"title": "Bengaluru: Kalyan Nagar residents protest commercial establishment in residential area", "para": "Residents of Kalyan Nagar 2nd Stage voiced strong opposition to the proposed transformation of a residential property into a commercial caf\u00e9. Their primary concerns revolved around potential disturbances, particularly the impact of increased foot traffic on children\u2019s health. Protesters pointed out the likelihood of noise pollution and parking troubles, and some cited instances of rudeness from the caf\u00e9 owner when expressing their grievances.", "href": "https://realty.economictimes.indiatimes.com/news/commercial/bengaluru-kalyan-nagar-residents-protest-commercial-establishment-in-residential-area/134536202?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-223318/134536202.cms?width=150&height=112", "tag": "commercial"}, {"title": "India to add 51.1 million sq ft of mall space by 2031; NCR to lead supply: Report", "para": "India\u2019s top seven cities are expected to add about 51.1 million sq ft of shopping mall space by 2031, taking total stock to 143.2 million sq ft, according to JLL. Large-format malls will account for 56% of the upcoming supply.", "href": "https://realty.economictimes.indiatimes.com/news/retail/india-to-add-51-1-million-sq-ft-of-mall-space-by-2031-ncr-to-lead-supply-report/134536147?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-275834/134536147.cms?width=150&height=112", "tag": "retail"}, {"title": "Housing sales rise 3% to one lakh units in Q3 2026; launches up 18%: Report", "para": "Housing sales across the top seven cities increased 3% year-on-year to about 1,00,220 units in Q3 2026, while new launches rose 18% to 1,14,320 units, according to Anarock. The value of homes sold increased 2% to approximately \u20b91.55 lakh crore.", "href": "https://realty.economictimes.indiatimes.com/news/residential/housing-sales-rise-3-to-one-lakh-units-in-q3-2026-launches-up-18-report/134536020?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-479612/134536020.cms?width=150&height=112", "tag": "residential"}]}