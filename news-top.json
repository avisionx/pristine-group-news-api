{"updated_at": {"date": {"d": "06", "m": "11", "Y": "2026"}, "time": {"H": "11", "M": "49", "S": "27"}}, "news": [{"title": "Six task forces to curb illegal sand mining in Rajasthan", "para": "The Rajasthan government has established six task forces to control illegal sand mining in river areas. These teams will operate in Sirohi, Sojat City, Jalore, Barmer, Jodhpur and Gotan. They will monitor compliance with environmental regulations, including mining depth and distance from riverbanks. Assistant mining engineers and other officials will ensure effective oversight and transparency in operations.", "href": "https://realty.economictimes.indiatimes.com/news/allied-industries/six-task-forces-to-curb-illegal-sand-mining-in-rajasthan/135597953?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-274838/135597953.cms?width=150&height=112", "tag": "allied-industries"}, {"title": "DLF to invest \u20b93,750 crore in JV with Everstone to acquire economic interest in IREO companies", "para": "DLF and Everstone Group have agreed to form a joint venture to invest in IREO and other IREO group companies in India. DLF plans to invest about \u20b93,750 crore for a majority stake in the JV, which will ultimately hold an aggregate economic interest of approximately 40% in the IREO India companies.", "href": "https://realty.economictimes.indiatimes.com/news/industry/dlf-to-invest-3750-crore-in-jv-with-everstone-to-acquire-economic-interest-in-ireo-companies/135598287?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-184172/135598287.cms?width=150&height=112", "tag": "industry"}, {"title": "Mumbai court takes cognisance of ED\u2019s money-laundering complaint against ex-director of Lodha, four others", "para": "A Mumbai special court responded to an Enforcement Directorate complaint against Rajendra N Lodha and others involving illicit land deals valued at Rs 85 crore. The court released Sahil Lodha from the matter, citing insufficient involvement, while also refraining from pursuing charges against Shital Palande due to factors related to his employment. This investigation was sparked by numerous police reports revealing serious financial irregularities.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/mumbai-court-takes-cognisance-of-eds-money-laundering-complaint-against-ex-director-of-lodha-four-others/135593271?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-101694/135593271.cms?width=150&height=112", "tag": "regulatory"}]}