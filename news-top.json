{"updated_at": {"date": {"d": "22", "m": "10", "Y": "2026"}, "time": {"H": "19", "M": "35", "S": "43"}}, "news": [{"title": "Sonu Sood leases commercial property in Mumbai for five years; rent outlay at \u20b93.52 crore", "para": "Actor Sonu Sood has leased out a commercial unit in Versova, Andheri West, Mumbai, for five years, with the aggregate rent over the tenure estimated at about \u20b93.52 crore. The transaction was registered in October 2026, according to Square Yards.", "href": "https://realty.economictimes.indiatimes.com/news/commercial/sonu-sood-leases-commercial-property-in-mumbai-for-five-years-rent-outlay-at-3-52-crore/135121183?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-38278/135121183.cms?width=150&height=112", "tag": "commercial"}, {"title": "State government reconstitutes Tamil Nadu Real Estate Regulatory Authority", "para": "The Tamil Nadu government has recently restructured its Real Estate Regulatory Authority, appointing retired IAS officer K Phanindra Reddy as the chairperson. This new team, composed of various retired bureaucrats and judges, emerges after a six-month supersession of the authority. The decisions were informed by a selection committee's recommendations set up by the government, showcasing a commitment to effective real estate governance.", "href": "https://realty.economictimes.indiatimes.com/news/rera/state-government-reconstitute-tamil-nadu-real-estate-regulatory-authority/135106139?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-80494/135106139.cms?width=150&height=112", "tag": "rera"}, {"title": "Goa: GSUDA to appoint agency to audit property tax survey", "para": "Goa State Urban Development Agency plans to hire a third-party agency to audit its GIS-based property tax survey. The agency will verify the accuracy of the municipal revenue mapping across various localities. This independent audit is aimed at ensuring reliability, which is essential for future property tax assessments. The audit will encompass data validation and sample field checks to identify discrepancies.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/goa-gsuda-to-appoint-agency-to-audit-property-tax-survey/135106047?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-155700/135106047.cms?width=150&height=112", "tag": "regulatory"}]}