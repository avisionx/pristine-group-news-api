{"updated_at": {"date": {"d": "03", "m": "09", "Y": "2026"}, "time": {"H": "12", "M": "18", "S": "57"}}, "news": [{"title": "Visakhapatnam: Velampeta families agree to shift temporarily for new housing complex", "para": "Residents will temporarily relocate to rented homes for a new housing complex.  The Greater Visakhapatnam Municipal Corporation will build apartment blocks at the existing settlement.  Each family will receive a free 410 sq ft flat with basic facilities.  Rental assistance of Rs 3,000 per month will be provided until construction concludes.  This project offers a permanent solution to housing issues for 177 families.", "href": "https://realty.economictimes.indiatimes.com/news/residential/visakhapatnam-velampeta-families-agree-to-shift-temporarily-for-new-housing-complex/133732823?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-367706/133732823.cms?width=150&height=112", "tag": "residential"}, {"title": "Ahmedabad civic body implements smart queue system for property bill name transfers", "para": "Ahmedabad Municipal Corporation has launched the LogBook360 Smart Queue Management System across its seven zonal offices. This innovative digital tool simplifies the process of managing queues for services like property tax name transfers. Citizens can now effortlessly secure instant tokens from self-service kiosks, benefitting from QR code check-ins and live updates on their queue status, leading to enhanced transparency and more efficient service delivery.", "href": "https://realty.economictimes.indiatimes.com/news/technology/ahmedabad-civic-body-implements-smart-queue-system-for-property-bill-name-transfers/133732761?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-111928/133732761.cms?width=150&height=112", "tag": "technology"}, {"title": "ASK Property Fund invests \u20b9300 crore in residential projects in Ghaziabad", "para": "ASK Property Fund has allocated \u20b9300 crore towards two residential projects in Ghaziabad, showcasing its commitment to urban development. In a strategic move, the fund has exited a Chennai project, securing a profit of \u20b9340 crore. Additionally, a \u20b9500 crore platform partnership with Bhumika Group has been established, focusing investments in real estate across the National Capital Region, with \u20b9125 crore designated for a plotted development in Faridabad.", "href": "https://realty.economictimes.indiatimes.com/news/residential/ask-property-fund-invests-300-crore-in-residential-projects-in-ghaziabad/133733380?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-497144/133733380.cms?width=150&height=112", "tag": "residential"}]}