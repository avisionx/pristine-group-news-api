{"updated_at": {"date": {"d": "15", "m": "09", "Y": "2026"}, "time": {"H": "06", "M": "54", "S": "15"}}, "news": [{"title": "Ghaziabad: Indirapuram highrise residents seek action on encroachment, transport, fire safety", "para": "Indirapuram societies came together for a community meeting focused on urgent civic and safety challenges. Central to their discussion were issues like unlawful encroachments, insufficient public transport options, and the pressing need for enhanced fire safety in aging buildings. Addressing traffic congestion and poor civic services, residents called for administrative intervention for infrastructure enhancement and better metro connectivity.", "href": "https://realty.economictimes.indiatimes.com/news/residential/ghaziabad-indirapuram-highrise-residents-seek-action-on-encroachment-transport-fire-safety/134252096?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-72284/134252096.cms?width=150&height=112", "tag": "residential"}, {"title": "Calcutta high court orders NKDA to raze illegal buildings in New Town complex", "para": "The Calcutta High Court ruled Rosedale Plaza is not independent from residential units. NKDA was directed to demolish construction outside the plaza's purchased area. The court found the plaza and residential complex are part of a singular housing project. Commercial hubs were conceptualized as common facilities for residents. Apartment owners will regain common areas occupied by the plaza owner.", "href": "https://realty.economictimes.indiatimes.com/news/regulatory/calcutta-high-court-orders-nkda-to-raze-illegal-buildings-in-new-town-complex/134252001?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-179168/134252001.cms?width=150&height=112", "tag": "regulatory"}, {"title": "Maharashtra's MahaBhumi Stack digital gateway now offers property ownership details", "para": "Home buyers in Maharashtra can now verify land ownership through a new digital platform. The MahaBhumi Stack consolidates multiple government land records, offering a user-friendly interface for property checks. This innovation allows citizens to access information on ownership, transaction history, and revenue court conditions efficiently, promoting transparency and combating property fraud effectively.", "href": "https://realty.economictimes.indiatimes.com/news/technology/maharashtras-mahabhumi-stack-digital-gateway-now-offers-property-ownership-details/134251801?utm_source=newslisting&utm_medium=latestNews", "img": "data:image/png;base64, ", "img-src": "https://etimg.etb2bimg.com/thumb/img-size-145210/134251801.cms?width=150&height=112", "tag": "technology"}]}